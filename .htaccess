# EinvaBill Apache hardening. Requires "AllowOverride All" on this directory.
Options -Indexes

# Never serve the database, logs, environment files, or helper scripts.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sqlite-journal|log|env|example|bat|sh|md|lock)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(package(-lock)?.json|tailwind..*.js)$">
    Require all denied
</FilesMatch>
<FilesMatch "^.(env|git|htaccess)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # The service worker has to be revalidated on every load, or a cached copy
    # keeps serving the old shell after a deploy.
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"

    # Uploaded images, icons and fonts are written once under a unique name, so
    # they can be cached hard. Without this the 2 MB company logo was revalidated
    # on every single page view.
    <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Stylesheets keep their filename across deploys but the pages request them
    # with ?v=<mtime>, so a long cache is safe and a new release still lands.
    <FilesMatch "\.css$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>
